body {
    text-align: center;
    font-family: 'Dancing Script', cursive;
    font-size: 20px;
    font-weight: 600;
    background: url("images/Flower_image.jpg");
    background-size: cover;
    color: #ffffff;
}

h1, h2, h3, h4, p {
    text-shadow: 0 0 1px black;
}

#bff-img {
    background-image: url("images/meri_Laila.jpeg");
    background-size: cover;
    background-position: center;
    width: min(250px, 80vw);
    aspect-ratio: 1;
    margin: 20px auto;
    border: 6px solid #EFB0C9;
    border-radius: 30%;
}
#bff-img:hover {
    transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("images/mygirl.jpg");
}

#bday-age {
    background: #EFB0C9;
    padding: 5px 10px;
    border-radius: 5px;
    margin: 5px 0 10px 0;
}

#bday-date {
    margin: 0;
    background: #EFB0C9;
    padding: 5px 10px;
    border-radius: 5px;
}

#header {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.music-player {
    width: min(420px, 90vw);
    margin: 30px auto 0;
    padding: 20px;
    box-sizing: border-box;
    border: 6px solid #EFB0C9;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.2);
}

.music-title {
    margin: 0 0 15px;
}

.music-artwork {
    width: min(280px, 75vw);
    aspect-ratio: 1;
    margin: 0 auto 15px;
    border: 4px solid white;
    border-radius: 12px;
    background: url("images/music_disk.jpg") center / cover no-repeat;
}

.song-name {
    margin: 10px 0;
}

#song-select {
    width: 100%;
    margin: 8px 0 15px;
    padding: 8px;
    font: inherit;
}

.music-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 15px;
}

.music-buttons button {
    padding: 8px 12px;
    border: 0;
    border-radius: 8px;
    background: #EFB0C9;
    color: white;
    font: inherit;
    cursor: pointer;
}

.music-buttons button:hover {
    background: #d889aa;
}

#audio-player {
    width: 100%;
}

.audio-status {
    min-height: 1.2em;
    margin: 10px 0 0;
    color: #8b163f;
}

.gift-section {
    margin-top: 50px;
}

.gift-title {
    margin-bottom: 10px;
}

.gift-hint {
    margin-top: 0;
}

.gift-img1,
.gift-img2,
.gift-img3,
.gift-img4,
.gift-img5 {
    margin: 20px auto;
    width: min(600px, 90vw);
    aspect-ratio: 1;
    border: 6px solid white;
    border-radius: 10px;
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(255, 255, 255, 0.25);
}

.gift-img1 {
    background-image: url("images/cover5.jpg");
}

.gift-img2 {
    background-image: url("images/cover4.jpg");
}

.gift-img3 {
    background-image: url("images/cover3.jpg");
}

.gift-img4 {
    background-image: url("images/cover2.jpg");
}

.gift-img5 {
    background-image: url("images/cover1.jpg");
}
#gift-img-happy:hover {
     transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("note/note1.jpeg");
}

#gift-img-hot:hover {
     transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("note/note2.jpeg");
}

#gift-img-genius:hover {
     transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("note/note3.jpeg");
}

#gift-img-badass:hover {
     transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("note/note4.jpeg");
}

#gift-img-cheers:hover {
     transform: scale(1.1);
    transition: transform 0.3s ease-in-out;
    background-image: url("note/note5.jpeg");
}

#footer {
    font-style: italic;
    width: 400px;
    margin: 40px auto 20px;
}

a {
    color: white;
}

